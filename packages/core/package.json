{
  "name": "@cascateer/core",
  "version": "2.4.102",
  "type": "module",
  "scripts": {
    "build": "tsup"
  },
  "tsup": {
    "entry": [
      "src/index.ts",
      "src/jsx-runtime/index.ts",
      "src/jsx-dev-runtime/index.ts",
      "src/operators/index.ts",
      "src/test/index.ts",
      "src/vite/index.ts"
    ],
    "format": [
      "esm"
    ],
    "dts": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./src/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./src/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./operators": {
      "types": "./src/operators/index.d.ts",
      "default": "./dist/operators.js"
    },
    "./test": {
      "types": "./src/test/index.d.ts",
      "default": "./dist/test.js"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "devDependencies": {
    "@cascateer/eslint-config": "*",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.1.2",
    "@types/object-hash": "^3.0.6",
    "@types/react": "^19.2.17",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@cascateer/lib": "*",
    "lodash": "^4.18.1",
    "object-hash": "^3.0.0",
    "rxjs": "^7.8.2",
    "utility-types": "^3.11.0",
    "uuid": "^14.0.1"
  },
  "peerDependencies": {
    "puppeteer": "^25.3.0",
    "vite": "^8.1.3",
    "vite-plugin-sass-dts": "^1.3.37"
  },
  "files": [
    "dist"
  ]
}
