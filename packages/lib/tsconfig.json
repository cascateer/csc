{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "types": ["node"],
    "lib": ["ESNext", "DOM", "WebWorker"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "ignoreDeprecations": "6.0",
    "composite": true,
    "declaration": true
  }
}
